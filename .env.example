# VISTA Architect — backend configuration
#
# Pick ONE backend by setting VISTA_LLM_BACKEND, then set the per-vendor
# credentials below for that backend.

VISTA_LLM_BACKEND=openai

# --- OpenAI (public) ---
OPENAI_API_KEY=sk-your-openai-key
# Optional: OpenAI-compatible gateway (vLLM, Together, OpenRouter, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (public) ---
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Google Gemini (public AI Studio) ---
# GOOGLE_API_KEY=AIza-your-gemini-key

# --- Google Vertex AI (the configuration used in the paper) ---
# Requires `gcloud auth application-default login` first.
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# Optional: override Anthropic-on-Vertex region (default: global)
# VERTEX_ANTHROPIC_REGION=us-east5
